# ~/.junior_it/zoom-pipeline.toml
repo_root = "/Users/dmitrymorozov/Projects/Junior_IT"
backup_dir = "/Volumes/backup/JuniorIT/recordings"
retention_days = 30
# стемы имён учеников: «Наст» накрывает Настя/Насте/Настю.
# Осторожно: стем короче 4-5 букв съедает обычные слова
# («Вик» замажет «викторину», «Маш» — «машину») — бери стем
# длиной с полное имя без окончания и проверь первый черновик глазами.
student_stems = ["placeholder_stem"]
